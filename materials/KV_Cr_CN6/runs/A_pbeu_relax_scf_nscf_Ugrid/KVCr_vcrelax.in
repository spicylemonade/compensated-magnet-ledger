  starting_magnetization(3) = 0.2143
  starting_magnetization(4) = 0.0000
  starting_magnetization(5) = 0.0000
/
&ELECTRONS
  conv_thr = 1.5d-06
  mixing_beta = 0.3
  electron_maxstep = 300
  mixing_mode = 'local-TF'
/
&IONS
/
&CELL

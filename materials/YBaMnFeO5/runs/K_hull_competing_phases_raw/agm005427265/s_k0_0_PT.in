  degauss = 0.005
  nspin = 2
  starting_magnetization(1) = 0.0000
  starting_magnetization(2) = 0.3000
  starting_magnetization(3) = -0.3000
  starting_magnetization(4) = 0.0000
/
&ELECTRONS
  conv_thr = 6.000000000000001d-08
  mixing_beta = 0.3
  electron_maxstep = 300
  mixing_mode = 'local-TF'
/

  pseudo_dir = '/data/pseudo/dojo_sr'
  tstress = .false.
  tprnfor = .false.
  disk_io = 'low'
  verbosity = 'high'
/
&SYSTEM
  ibrav = 0
  nat = 6
  ntyp = 4
  ecutwfc = 75.0
  ecutrho = 300.0
  occupations = 'smearing'

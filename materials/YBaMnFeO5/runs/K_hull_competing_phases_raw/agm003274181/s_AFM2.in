&CONTROL
  calculation = 'scf'
  prefix = 's_AFM2'
  outdir = '/tmp/scratch/s_AFM2'
  pseudo_dir = '/data/pseudo/dojo_sr'
  tstress = .false.
  tprnfor = .false.
  disk_io = 'low'
  verbosity = 'high'
/
&SYSTEM
  ibrav = 0
  nat = 4
  ntyp = 3
  ecutwfc = 75.0
  ecutrho = 300.0
  occupations = 'smearing'
  smearing = 'gaussian'
  degauss = 0.005
  nspin = 2
  starting_magnetization(1) = 0.2625
  starting_magnetization(2) = -0.2625
  starting_magnetization(3) = 0.0000
/
&ELECTRONS
  conv_thr = 4d-08
  mixing_beta = 0.3
  electron_maxstep = 300
  mixing_mode = 'local-TF'
/
ATOMIC_SPECIES
  Fe 55.8450 Fe.upf
  Fe1 55.8450 Fe.upf
  O 15.9990 O.upf
CELL_PARAMETERS angstrom
  -2.1650000000 2.1650000000 0.0000000000
  0.0000000000 -2.1650000000 2.1650000000
  2.1650000000 2.1650000000 4.3300000000
ATOMIC_POSITIONS crystal
  Fe 0.0000000000 0.0000000000 0.0000000000
  Fe1 0.5000000000 0.0000000000 0.5000000000
  O 0.7500000000 0.5000000000 0.7500000000
  O 0.2500000000 0.5000000000 0.2500000000
K_POINTS automatic
  10 11 6 0 0 0
HUBBARD ortho-atomic
  U Fe-3d 4.0
  U Fe1-3d 4.0

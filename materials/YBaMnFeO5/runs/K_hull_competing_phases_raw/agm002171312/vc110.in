&CONTROL
  calculation = 'vc-relax'
  prefix = 'vc110'
  outdir = '/tmp/scratch/vc110'
  pseudo_dir = '/data/pseudo/dojo_sr'
  tstress = .true.
  tprnfor = .true.
  disk_io = 'low'
  verbosity = 'high'
  forc_conv_thr = 0.001
  etot_conv_thr = 0.0001
  nstep = 150
/
&SYSTEM
  ibrav = 0
  nat = 10
  ntyp = 3
  ecutwfc = 110.0
  ecutrho = 440.0
  occupations = 'smearing'
  smearing = 'gaussian'
  degauss = 0.005
  nspin = 2
  starting_magnetization(1) = 0.2625
  starting_magnetization(2) = -0.2625
  starting_magnetization(3) = 0.0000
/
&ELECTRONS
  conv_thr = 1d-07
  mixing_beta = 0.3
  electron_maxstep = 300
  mixing_mode = 'local-TF'
/
&IONS
/
&CELL
  press_conv_thr = 0.3
/
ATOMIC_SPECIES
  Fe 55.8450 Fe.upf
  Fe1 55.8450 Fe.upf
  O 15.9990 O.upf

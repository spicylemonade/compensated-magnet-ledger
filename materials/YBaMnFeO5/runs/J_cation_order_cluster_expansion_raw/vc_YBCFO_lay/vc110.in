  starting_magnetization(5) = -0.2625
  starting_magnetization(6) = 0.2625
  starting_magnetization(7) = 0.0000
/
&ELECTRONS
  conv_thr = 1.8d-07
  mixing_beta = 0.3
  electron_maxstep = 300
  mixing_mode = 'local-TF'
/
&IONS
/
&CELL
  press_conv_thr = 0.3
/

&CONTROL
  calculation = 'vc-relax'
  prefix = 'vc110'
  outdir = '/tmp/scratch/vc110'
  pseudo_dir = '/data/pseudo/dojo_sr'
  tstress = .true.
  tprnfor = .true.
  disk_io = 'low'
  verbosity = 'high'
  forc_conv_thr = 0.001
  etot_conv_thr = 0.00018
  nstep = 150
/
&SYSTEM
  ibrav = 0
  nat = 18
  ntyp = 7
  ecutwfc = 110.0
  ecutrho = 440.0
  occupations = 'smearing'
